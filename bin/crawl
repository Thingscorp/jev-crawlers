#!/usr/bin/env node
// crawl — thin orchestrator over the unix pipe.
//
//   jev-seed -> [ frontier -> jev-judge -> jev-expand ]* -> jev-verify -> jev-report
//
// Stages are dumb filters speaking JSON lines; this script owns the
// recursion: it runs the seed/judge/expand loop against its own frontier,
// visited set, and budgets, then hands the surviving candidates to
// jev-verify and jev-report.
//
// The driver keeps: canonical node identity (file+symbol+scope), a visited
// set, and a priority frontier. Termination: budget spent, depth cap,
// empty frontier, or the diminishing-returns gate (8 straight low-risk
// outcomes: pruned or sent to the review queue, all in the low risk band).
// Judgment calls Jev; expansion is mechanical.
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { execFileSync } from 'node:child_process';
import { Frontier, childPriority, withId } from '../lib/graph.mjs';
import { fileExcerpt } from '../lib/search.mjs';
import { attachEvidence } from '../lib/evidence.mjs';
import { fail } from '../lib/io.mjs';

const HERE = path.dirname(fileURLToPath(import.meta.url));

function printVersion() {
  let v = 'unknown';
  try { v = JSON.parse(fs.readFileSync(path.join(HERE, '..', 'package.json'), 'utf8')).version || v; } catch {}
  console.log(`crawl ${v}`);
  process.exit(0);
}

function printHelp() {
  console.log(`usage: crawl --repo PATH [--seed diff|todo|patterns] [--base HEAD] [--budget 60]
             [--depth 6] [--decay 0.85] [--max-children 12] [--only a.js,b.js]
             [--api-key KEY] [--out report.md] [--json [report.json]]
             [--stats-json] [--telemetry] [--dry-run] [--no-color] [--version]

Orchestrate the jev-seed | jev-judge | jev-expand loop, then jev-verify
and jev-report. Stages speak NDJSON on stdin/stdout; this driver owns the
frontier, the visited set, budgets, and the four stop rules (budget spent,
depth cap, empty frontier, diminishing returns: 8 straight low-risk
outcomes).

Options:
  --repo PATH        repo to crawl (default: current directory)
  --seed KIND        repeatable; diff | todo | patterns (default: all three)
  --base REF         diff base for --seed diff (default: HEAD)
  --budget N         max Jev judgments (default: 60)
  --depth N          max expansion depth (default: 6)
  --decay F          child priority decay per depth (default: 0.85)
  --max-children N   expansion cap per node (default: 12)
  --only F,...       restrict seeds to these files
  --api-key KEY      Vercel AI Gateway key (see Configuration below)
  --out FILE         write the Markdown report to FILE (default: stdout)
  --json [FILE]      write findings JSON; to FILE, or to stdout when bare
  --stats-json       write run stats as JSON to stderr
  --telemetry        append one NDJSON record of run counts/timings/cost
                     to data/telemetry.jsonl (opt-in; off by default).
                     Never records file paths, source, excerpts, or
                     finding details. See docs/TELEMETRY.md.
  --dry-run          stub judgments (expand everything); no Jev calls,
                     no key needed
  --no-color         no color output (output is plain text anyway)
  -h, --help         this help
  --version          print version

Configuration — the gateway key, first source found wins:
  --api-key flag; $AI_GATEWAY_API_KEY; api_key= in
  ~/.config/jev-crawlers/config (KEY=VALUE lines, # comments).
  A key is required unless --dry-run. It is never prompted for, never
  logged, and never stored in a repo.

Exit codes: 0 success, 1 runtime error, 2 usage/config error.

Examples:
  crawl --repo /path/to/repo --seed diff --budget 40 --out report.md
  crawl --repo ./examples/todo-app --dry-run --budget 8
  crawl --repo /path/to/repo --seed patterns --json findings.json`);
  process.exit(0);
}

const args = process.argv.slice(2);
let repo = process.cwd(), seedKinds = [], base = 'HEAD', budget = 60, maxDepth = 6,
  decay = 0.85, maxChildren = 12, outFile = null, jsonFile = null, jsonStdout = false,
  dryRun = false, only = null, statsJson = false, telemetry = false, noColor = false,
  apiKey = null;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--repo' && args[i + 1]) repo = args[++i];
  else if (a === '--seed' && args[i + 1]) seedKinds.push(args[++i]);
  else if (a === '--base' && args[i + 1]) base = args[++i];
  else if (a === '--budget' && args[i + 1]) {
    budget = parseInt(args[++i], 10);
    if (!Number.isInteger(budget) || budget < 0) fail(`--budget must be a non-negative integer (got "${args[i]}")`, 2);
  }
  else if (a === '--depth' && args[i + 1]) maxDepth = parseInt(args[++i], 10);
  else if (a === '--decay' && args[i + 1]) decay = parseFloat(args[++i]);
  else if (a === '--max-children' && args[i + 1]) maxChildren = parseInt(args[++i], 10);
  else if (a === '--only' && args[i + 1]) only = args[++i];
  else if (a === '--api-key' && args[i + 1]) apiKey = args[++i];
  else if (a === '--out' && args[i + 1]) outFile = args[++i];
  else if (a === '--json' && args[i + 1] && !args[i + 1].startsWith('-')) jsonFile = args[++i];
  else if (a === '--json') jsonStdout = true;
  else if (a === '--stats-json') statsJson = true;
  else if (a === '--telemetry') telemetry = true;
  else if (a === '--dry-run') dryRun = true;
  else if (a === '--no-color') noColor = true;
  else if (a === '--version') printVersion();
  else if (a === '--help' || a === '-h') printHelp();
  else fail(`unknown arg ${a}`, 2);
}
if (!seedKinds.length) seedKinds = ['diff', 'todo', 'patterns'];
repo = path.resolve(repo);
// A --api-key flag is exported so the Jev stage (and any other child)
// picks it up; prefer the config file or env var to keep it out of
// shell history and process listings.
if (apiKey) process.env.AI_GATEWAY_API_KEY = apiKey;

const t0 = Date.now();
const timingsMs = { seed: 0, judge: 0, expand: 0, verify: 0, report: 0 };
const pipe = (bin, binArgs, recordsIn) => {
  const rows = recordsIn == null ? [] : Array.isArray(recordsIn) ? recordsIn : [recordsIn];
  const res = execFileSync('node', [path.join(HERE, bin), ...binArgs], {
    cwd: repo, encoding: 'utf8', env: process.env,
    input: rows.map((r) => JSON.stringify(r)).join('\n') + '\n',
    stdio: ['pipe', 'pipe', 'inherit'], maxBuffer: 64 * 1024 * 1024,
  });
  return res.split('\n').filter((l) => l.trim()).map((l) => JSON.parse(l));
};

const tSeed = Date.now();
const seedArgs = ['--repo', repo, '--base', base, ...(only ? ['--only', only] : [])];
for (const s of seedKinds) seedArgs.push('--' + s);
let seeds;
try {
  seeds = pipe('jev-seed.mjs', seedArgs, null);
} catch (e) { fail(`jev-seed failed: ${e.message}`, 1); }
timingsMs.seed = Date.now() - tSeed;
for (const s of seeds) {
  withId(s);
  const around = Number((s.evidence || []).find((e) => e && Number(e.line) > 0)?.line)
    || Number(s.symbolLine)
    || 1;
  const { excerpt, symbolLine, excerptStartLine } = fileExcerpt(repo, s.file, around, 30);
  s.excerpt = excerpt; s.symbolLine = symbolLine; s.excerptStartLine = excerptStartLine;
}

const frontier = new Frontier();
const visited = new Set();
for (const s of seeds) frontier.push(s);

const candidates = [];
let judged = 0, pruned = 0, expanded = 0, depthCapped = 0;
let estCostUsd = 0, totalLatencyMs = 0;
const recent = [];
let termination = 'frontier-empty';

const stubJudgment = (node) => ({
  answers: {
    verdict: { choice: 'expand', probabilities: { expand: 1 }, top_probability: 1 },
    bug_likely: { probability: 0.5 },
    risk: { score: 1 },
    artifact_stated: { probability: 0 },
  },
  routing: 'expand-node', meaning: 'dry-run stub', latencyMs: 0, dryRun: true,
});

while (frontier.size > 0) {
  const node = frontier.pop();
  if (visited.has(node.id)) continue;
  visited.add(node.id);
  if ((node.depth ?? 0) > maxDepth) { depthCapped++; continue; }
  if (judged >= budget) { termination = 'budget-exhausted'; break; }

  let judgment;
  if (dryRun) {
    judgment = stubJudgment(node);
  } else {
    try {
      const tJudge = Date.now();
      const [res] = pipe('jev-judge.mjs', [], node);
      timingsMs.judge += Date.now() - tJudge;
      judgment = res.judgment;
    } catch (e) {
      process.stderr.write(`crawl: judge failed on ${node.id}, treating as review: ${e.message.slice(0, 120)}\n`);
      candidates.push({ node, judgment: { routing: 'escalate-owner', answers: {}, note: 'judge error' } });
      continue;
    }
  }
  judged++;
  totalLatencyMs += judgment.latencyMs || 0;
  if (!dryRun) estCostUsd += (typeof judgment.marketCostUsd === 'number' && judgment.marketCostUsd >= 0)
    ? judgment.marketCostUsd : 0.00008;

  const bugP = judgment.answers?.bug_likely?.probability ?? 0;
  const risk = judgment.answers?.risk?.score ?? 0;
  recent.push({ routing: judgment.routing, bugP, risk });
  if (recent.length > 8) recent.shift();

  const routing = judgment.routing || 'auto-prune';
  if (routing === 'expand-node') {
    expanded++;
    if ((node.depth ?? 0) >= maxDepth) continue;
    let children = [];
    try {
      const tExpand = Date.now();
      children = pipe('jev-expand.mjs', ['--repo', repo, '--max-children', String(maxChildren)], node);
      timingsMs.expand += Date.now() - tExpand;
    } catch (e) {
      process.stderr.write(`crawl: expand failed on ${node.id}: ${e.message.slice(0, 120)}\n`);
    }
    for (const c of children) {
      withId(c);
      if (visited.has(c.id)) continue;
      c.priority = childPriority(node, judgment, decay);
      frontier.push(c);
    }
  } else if (routing === 'auto-prune') {
    pruned++;
  } else {
    judgment.attachedEvidence = attachEvidence(node);
    candidates.push({ node, judgment });
  }

  if (recent.length === 8 && recent.every((r) => (r.routing === 'auto-prune' || r.routing === 'review-queue') && r.risk < 1)) {
    termination = 'diminishing-returns';
    break;
  }
}
if (termination === 'frontier-empty' && judged >= budget) termination = 'budget-exhausted';

const stats = {
  nodesVisited: visited.size, seeds: seeds.length, judgments: judged,
  pruned, expanded, depthCapped,
  candidates: candidates.length,
  estCostUsd: Math.round(estCostUsd * 100000) / 100000,
  avgLatencyMs: judged ? Math.round(totalLatencyMs / judged) : 0,
  wallMs: Date.now() - t0, termination, dryRun,
};

let verified = [];
if (candidates.length) {
  try {
    const tVerify = Date.now();
    verified = pipe('jev-verify.mjs', [], candidates);
    timingsMs.verify = Date.now() - tVerify;
  } catch (e) { fail(`jev-verify failed: ${e.message}`, 1); }
}
let report = '';
try {
  const tReport = Date.now();
  const reportArgs = ['--stats', JSON.stringify(stats)];
  if (outFile) reportArgs.push('--out', outFile);
  if (jsonFile) reportArgs.push('--json', jsonFile);
  else if (jsonStdout) reportArgs.push('--json');
  report = execFileSync('node', [path.join(HERE, 'jev-report.mjs'), ...reportArgs], {
    cwd: repo, encoding: 'utf8', env: process.env,
    input: verified.map((v) => JSON.stringify(v)).join('\n') + '\n', stdio: ['pipe', 'pipe', 'inherit'], maxBuffer: 64 * 1024 * 1024,
  });
  timingsMs.report = Date.now() - tReport;
} catch (e) { fail(`jev-report failed: ${e.message}`, 1); }

timingsMs.total = Date.now() - t0;

if (telemetry) {
  const record = {
    ts: new Date().toISOString(),
    schema: 1,
    counts: {
      seeds: seeds.length,
      nodesVisited: visited.size,
      judgments: judged,
      pruned,
      expanded,
      depthCapped,
      candidates: candidates.length,
      bugs: verified.filter((v) => v.status === 'bug').length,
      unverifiedLeads: verified.filter((v) => v.status === 'unverified-lead').length,
      escalated: verified.filter((v) => v.status === 'escalated').length,
    },
    timingsMs,
    estCostUsd: stats.estCostUsd,
    termination,
    dryRun,
  };
  const telPath = path.join(HERE, '..', 'data', 'telemetry.jsonl');
  try {
    fs.mkdirSync(path.dirname(telPath), { recursive: true });
    fs.appendFileSync(telPath, JSON.stringify(record) + '\n');
  } catch (e) {
    // Telemetry is opt-in observability: a failed append must never
    // discard the report. Warn and continue with exit semantics unchanged.
    process.stderr.write(`crawl: warning: telemetry append failed (${e.message}); continuing\n`);
  }
}

if (!outFile) process.stdout.write(report);
if (statsJson) process.stderr.write(JSON.stringify(stats) + '\n');
else process.stderr.write(`crawl: ${visited.size} nodes, ${judged} judgments, ` +
  `${verified.filter((v) => v.status === 'bug').length} bugs, ` +
  `${verified.filter((v) => v.status === 'unverified-lead').length} unverified leads, ` +
  `~$${stats.estCostUsd.toFixed(5)} est., done: ${termination}\n`);
